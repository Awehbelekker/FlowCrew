  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "entryPoint": "./index.js"
  },
  "scripts": {
    "start": "expo start",
    "start-flowcrew": "EXPO_MAIN=./index.flowcrew.js expo start",
    "start-flowcrew-win": "set EXPO_MAIN=./index.flowcrew.js && expo start",
    "web": "expo start --web",
    "build": "webpack",
    "start-web": "webpack serve --mode development",
